\theoremstyle{mystyle}
\newtheorem{pproblem}{Problem}
\makeatother

% time-limit clock drawn with TikZ, so the handouts build without the clock metafont
\newcommand{\clock}[2]{%
  \begin{tikzpicture}[baseline=-0.6ex,scale=0.32,line cap=round]
    \draw (0,0) circle (1);
    \foreach \i in {0,30,...,330} \draw (\i:0.82) -- (\i:1);
    \draw (90-#1*30-#2*0.5:0.5) -- (0,0);
    \draw[thick] (90-#2*6:0.75) -- (0,0);
  \end{tikzpicture}%
}

